[user]
	name = Shun Tedokon
	email = shun@tedokon.com
[include]
	path = ~/.config/git/1password-signing.config
[core]
	autocrlf = input
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[init]
	defaultBranch = main
[pull]
	ff = only
[push]
	autoSetupRemote = true
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true
[tag]
	gpgSign = true
[mailmap]
	file = /Users/tdkn/.config/git/mailmap
[gitbutler]
	aiOpenAIKeyOption = bringYourOwn
	aiAnthropicKeyOption = bringYourOwn
	aiOpenAIModelName = gpt-5.4
	aiAnthropicModelName = claude-sonnet-4-6
	aiModelProvider = anthropic
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
