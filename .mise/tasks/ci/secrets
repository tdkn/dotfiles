#!/usr/bin/env bash
#MISE description="Scan the latest commit's diff for secrets"
set -euo pipefail

# A pull request checkout is a merge commit, so HEAD^1 is the base branch.
git diff --no-ext-diff --no-textconv --no-color --src-prefix=a/ --dst-prefix=b/ HEAD^1 HEAD |
  betterleaks stdin --git-diff --redact --no-banner --validate=false --analyze=false
