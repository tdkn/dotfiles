#!/usr/bin/env bash
set -euo pipefail

# The Brewfile lists the Apple Silicon packages, so only the Homebrew under
# /opt/homebrew may rewrite it; an Intel Homebrew under /usr/local must not.
HOMEBREW_NO_AUTO_UPDATE=1 /opt/homebrew/bin/brew bundle dump \
  --file ~/.config/homebrew/Brewfile \
  --force \
  --no-describe \
  --formula \
  --cask \
  --mas \
  --no-tap
