#!/usr/bin/env bash
set -euo pipefail

# Only the Apple Silicon Homebrew may rewrite this formula list. An Intel Mac
# can have a separate Homebrew installation under /usr/local.
HOMEBREW_NO_AUTO_UPDATE=1 /opt/homebrew/bin/brew bundle dump \
  --file ~/.config/homebrew/Brewfile \
  --force \
  --no-describe \
  --formula \
  --no-cask \
  --no-tap
