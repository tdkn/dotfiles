# GitHub CLI command rules for Codex outside-sandbox execution.
# This Starlark file is loaded at startup; restart Codex after changing it.
# Keep allow rules narrow; use prompt or forbidden for mutating or sensitive commands.

prefix_rule(
    pattern = ["gh", "repo", ["view", "list"]],
    decision = "allow",
    justification = "Read GitHub repository metadata",
    match = [
        "gh repo view",
        "gh repo view openai/codex",
        "gh repo list openai --limit 10",
    ],
    not_match = [
        "gh repo create",
        "gh repo delete openai/codex",
    ],
)

prefix_rule(
    pattern = ["gh", "issue", ["view", "list", "status"]],
    decision = "allow",
    justification = "Read GitHub issues",
    match = [
        "gh issue view 1",
        "gh issue list --state open",
        "gh issue status",
    ],
    not_match = [
        "gh issue comment 1 --body ok",
        "gh issue edit 1 --title updated",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", ["view", "list", "diff", "checks", "status"]],
    decision = "allow",
    justification = "Read pull request metadata, diffs, and checks",
    match = [
        "gh pr view 1 --json title",
        "gh pr list --state open",
        "gh pr diff 1",
        "gh pr checks 1",
        "gh pr status",
    ],
    not_match = [
        "gh pr checkout 1",
        "gh pr comment 1 --body ok",
        "gh pr merge 1",
    ],
)

prefix_rule(
    pattern = ["gh", "run", ["list", "view", "watch"]],
    decision = "allow",
    justification = "Read GitHub Actions run status and logs",
    match = [
        "gh run list",
        "gh run view 123",
        "gh run watch 123",
    ],
    not_match = [
        "gh run cancel 123",
        "gh run rerun 123",
    ],
)

prefix_rule(
    pattern = ["gh", "workflow", ["list", "view"]],
    decision = "allow",
    justification = "Read GitHub Actions workflow metadata",
    match = [
        "gh workflow list",
        "gh workflow view test.yml",
    ],
    not_match = [
        "gh workflow run test.yml",
        "gh workflow disable test.yml",
    ],
)

prefix_rule(
    pattern = ["gh", "project", ["list", "view", "item-list", "field-list"]],
    decision = "allow",
    justification = "Read GitHub Projects data",
    match = [
        "gh project list --owner openai",
        "gh project view 1 --owner openai",
        "gh project item-list 1 --owner openai",
        "gh project field-list 1 --owner openai",
    ],
    not_match = [
        "gh project item-add 1 --owner openai --url https://github.com/openai/codex/issues/1",
        "gh project edit 1 --owner openai --title Roadmap",
    ],
)

prefix_rule(
    pattern = ["gh", "search", ["issues", "prs", "repos", "commits"]],
    decision = "allow",
    justification = "Search GitHub resources without mutation",
    match = [
        "gh search issues codex",
        "gh search prs codex",
        "gh search repos codex",
        "gh search commits codex",
    ],
    not_match = [
        "gh search code secret",
    ],
)

prefix_rule(
    pattern = ["gh", "search", "code"],
    decision = "prompt",
    justification = "GitHub code search may send sensitive snippets as query text",
    match = [
        "gh search code TODO",
    ],
)

prefix_rule(
    pattern = ["gh", "release", ["view", "list"]],
    decision = "allow",
    justification = "Read GitHub release metadata",
    match = [
        "gh release view v1.0.0",
        "gh release list",
    ],
    not_match = [
        "gh release create v1.0.0",
        "gh release upload v1.0.0 artifact.tgz",
    ],
)

# gh api is powerful and can mutate via method flags or GraphQL mutations.
prefix_rule(
    pattern = ["gh", "api"],
    decision = "prompt",
    justification = "GitHub API calls may mutate data; review each invocation",
    match = [
        "gh api repos/{owner}/{repo}",
        "gh api graphql -f query={viewer{login}}",
    ],
)

# Authentication status masks tokens unless token output flags are passed.
prefix_rule(
    pattern = ["gh", "auth", "status"],
    decision = "allow",
    justification = "Read GitHub authentication status with token output masked",
    match = [
        "gh auth status",
        "gh auth status --hostname github.com",
    ],
)

prefix_rule(
    pattern = ["gh", "auth", "status", "--show-token"],
    decision = "forbidden",
    justification = "Do not print GitHub tokens; run gh auth status without token flags instead",
    match = [
        "gh auth status --show-token",
        "gh auth status --show-token --hostname github.com",
    ],
)

prefix_rule(
    pattern = ["gh", "auth", "status", "-t"],
    decision = "forbidden",
    justification = "Do not print GitHub tokens; run gh auth status without token flags instead",
    match = [
        "gh auth status -t",
        "gh auth status -t --hostname github.com",
    ],
)

prefix_rule(
    pattern = ["gh", "auth", "token"],
    decision = "forbidden",
    justification = "Do not print GitHub tokens",
    match = [
        "gh auth token",
        "gh auth token --hostname github.com",
    ],
)

prefix_rule(
    pattern = ["gh", "secret"],
    decision = "forbidden",
    justification = "Do not access or modify GitHub secrets automatically",
    match = [
        "gh secret list",
        "gh secret set TOKEN",
    ],
)

prefix_rule(
    pattern = ["gh", "variable"],
    decision = "prompt",
    justification = "Repository variables may expose or mutate configuration",
    match = [
        "gh variable list",
        "gh variable get NAME",
        "gh variable set NAME --body value",
    ],
)
